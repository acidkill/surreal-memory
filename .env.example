# SurrealMemory Environment Variables
# Copy this file to .env and fill in values as needed.

# --- Core ---
# Data directory (default: ~/.surrealmemory)
# NEURALMEMORY_DIR=/path/to/data

# Default brain name
# NMEM_BRAIN=default

# --- Server ---
# Host and port for the API server
# NMEM_HOST=127.0.0.1
# NMEM_PORT=8000

# Trusted networks (CIDR notation, comma-separated)
# NEURAL_MEMORY_TRUSTED_NETWORKS=172.17.0.0/16

# --- SurrealDB (graph + vector storage backend) ---
# SURREALDB_URL=http://localhost:8001
# SURREALDB_USER=root
# SURREALDB_PASS=neuralmemory
# SURREALDB_NS=neural_memory
# SURREALDB_DB=default

# --- Storage Backend ---
# Options: sqlite, surrealdb, falkordb, postgres
# NEURAL_MEMORY_STORAGE=surrealdb

# --- Encryption ---
# Enable memory encryption at rest
# NMEM_ENCRYPTION_ENABLED=false
# NMEM_ENCRYPTION_KEYS_DIR=/path/to/keys

# --- Sync (Hub) ---
# Hub server URL for multi-device sync
# NMEM_HUB_URL=https://neural-memory-sync-hub.toni-nowak84.workers.dev
# NMEM_API_KEY=nmk_your_key_here
# NMEM_DEVICE_ID=my-laptop
# NMEM_SYNC_ENABLED=true
# NMEM_SYNC_AUTO=true

# --- FalkorDB (optional graph backend) ---
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# --- Embedding (Gemini 2.0) ---
# NEURAL_MEMORY_EMBEDDING_ENABLED=true
# NEURAL_MEMORY_EMBEDDING_PROVIDER=gemini
# NEURAL_MEMORY_EMBEDDING_MODEL=gemini-embedding-exp-03-07
# GEMINI_API_KEY=your-gemini-api-key

# --- Embedding (other providers) ---
# OPENAI_API_KEY=

# --- Claude Code hooks ---
# Session ID (auto-set by Claude Code)
# CLAUDE_SESSION_ID=
